{
  "name": "strapi-headless-content-manager-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:plugin dev:playground",
    "dev:plugin": "npm run watch --workspace packages/plugin",
    "dev:playground": "npm run develop --workspace apps/playground",
    "build": "npm run build --workspace packages/plugin",
    "seed": "npm run seed --workspace apps/playground",
    "test:unit": "vitest run tests/unit",
    "test:contract": "playwright test",
    "drift:hashes": "node drift/scripts/update-hashes.mjs",
    "drift:check": "node drift/scripts/check.mjs",
    "drift:update": "node drift/scripts/update-manifest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "npm-run-all": "^4.1.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
