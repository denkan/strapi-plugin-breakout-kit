{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Exercises every field type: the main test subject for the headless content manager"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "body": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "legacyBody": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "wordCount": {
      "type": "integer"
    },
    "price": {
      "type": "decimal"
    },
    "rating": {
      "type": "float"
    },
    "viewCount": {
      "type": "biginteger"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "publishDate": {
      "type": "date"
    },
    "publishTime": {
      "type": "time"
    },
    "exactMoment": {
      "type": "datetime"
    },
    "tone": {
      "type": "enumeration",
      "enum": ["formal", "casual", "technical"]
    },
    "contactEmail": {
      "type": "email"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "videos", "files", "audios"]
    },
    "metadata": {
      "type": "json"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "heroCategory": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "contributors": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::author.author"
    },
    "spotlightAuthor": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::author.author",
      "mappedBy": "spotlightArticle"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "quotes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.quote"
    },
    "sections": {
      "type": "dynamiczone",
      "components": ["shared.quote", "shared.media-block", "shared.link"]
    }
  }
}
